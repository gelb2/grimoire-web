# 기존 .env.local에 덮어쓰지 말고 별도 프로세스에 주입한다.
NEXT_PUBLIC_APP_ENV=localhost
API_URL=http://localhost:3000/api
PORT=3001

# 선택: 브라우저에 공개되는 식별자. 서버 비밀키를 넣지 않는다.
# NEXT_PUBLIC_*는 next build 시 포함되므로 값 변경 시 다시 빌드한다.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# 로컬 E2E. 가상 시드의 계정만 사용한다.
E2E_AUTHOR_EMAIL=writer@example.test
E2E_AUTHOR_SLUG=local-writer
E2E_AUTHOR_PASSWORD=
E2E_ADMIN_EMAIL=admin@example.test
E2E_ADMIN_PASSWORD=

# 브라우저 직접 API 통신을 허용할 때만 설정. 기본은 같은 출처 BFF.
NEXT_PUBLIC_API_ORIGIN=

# 사이트맵에 사용할 본인 사이트 출처. 미설정 시 사이트맵 항목을 만들지 않음.
NEXT_PUBLIC_SITE_URL=
# 개인정보/약관 화면의 본인 문의 이메일 (런타임).
LEGAL_CONTACT_EMAIL=
