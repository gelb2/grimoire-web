# App
NEXT_PUBLIC_APP_ENV=local

# BFF 패턴: 서버 사이드에서 백엔드 직접 호출용 (런타임 환경변수)
API_URL=http://localhost:3000/api

# E2E 테스트 (Playwright) — EMAIL-P0-1 (2026-05-04) @grimoire.app 박제 정리
# E2E_AUTHOR_EMAIL: dev DB에 박제된 실 작가 이메일 (default: 시드 스크립트 갱신값 deerdevil@example.com)
# E2E_AUTHOR_PASSWORD: 위 작가 비밀번호 (필수, 미박제 시 e2e fail)
# E2E_AUTHOR_SLUG: EMAIL-P0-3 Phase 2 — slug 로그인 e2e 박제 (default: deerdevil)
#                  박제 시 dashboard.spec.ts가 slug로 로그인, 미박제 시 EMAIL로 로그인 (양립)
E2E_AUTHOR_EMAIL=deerdevil@example.com
E2E_AUTHOR_PASSWORD=
E2E_AUTHOR_SLUG=deerdevil

# E2E 관리자 — admin.spec.ts / account-delete.spec.ts(시나리오 2·3 force delete / GDPR anonymize)
# E2E_ADMIN_EMAIL: 관리자 이메일 (default: admin@grimoire-book.com)
# E2E_ADMIN_PASSWORD: 관리자 비밀번호 (미박제 시 admin 의존 it 는 test.skip)
E2E_ADMIN_EMAIL=admin@grimoire-book.com
E2E_ADMIN_PASSWORD=

# Playwright dev 환경 대상 실행 (USER-SOFT-DELETE 3 시나리오, 2026-05-17)
# PLAYWRIGHT_BASE_URL 박제 시 playwright.config.ts 가 webServer 비활성 + headed 강제 (reCAPTCHA v3 대응).
# 예: PLAYWRIGHT_BASE_URL=https://dev.grimoire-book.com E2E_AUTHOR_PASSWORD=... npm run test:e2e -- account-delete
# PLAYWRIGHT_BASE_URL=https://dev.grimoire-book.com
