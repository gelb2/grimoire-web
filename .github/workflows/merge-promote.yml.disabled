name: Merge Promote
on:
  workflow_dispatch:
    inputs:
      target:
        description: 'Promote to which branch'
        required: true
        type: choice
        options:
          - inhouse
          - production
        default: inhouse

jobs:
  promote:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Configure git
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"

      - name: Promote to inhouse
        if: inputs.target == 'inhouse'
        run: |
          git checkout inhouse
          git merge origin/develop --no-ff -m "merge: develop → inhouse (자동 프로모션)"
          git push origin inhouse

      - name: Promote to production
        if: inputs.target == 'production'
        run: |
          git checkout inhouse
          git merge origin/develop --no-ff -m "merge: develop → inhouse (자동 프로모션)"
          git push origin inhouse
          git checkout main
          git merge inhouse --no-ff -m "merge: inhouse → main (자동 프로모션)"
          git push origin main
